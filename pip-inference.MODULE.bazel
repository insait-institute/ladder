# inference-client.

pip_env.env(
    name = "inference-models-capx",
    deps = ["inference-client"],
    paths = ["ladder/components/inference/models/capx"],
    pyproject = "//ladder/components/inference/models/capx:pyproject.toml",
)

pip.parse(
    # Index mode, so the range-pinned torch resolves from the PyTorch cu128 index and not PyPI.
    experimental_index_url = "https://pypi.org/simple",
