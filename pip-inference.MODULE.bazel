        "torch": "https://download.pytorch.org/whl/cu128",
        "torchvision": "https://download.pytorch.org/whl/cu128",
    },
    hub_name = "pip-inference-models-capx",
    python_version = "3.10",
    requirements_lock = "//:ladder/components/inference/models/capx/requirements.txt.lock",
    target_platforms = ["linux_x86_64"],
)

use_repo(pip, "pip-inference-models-capx")

