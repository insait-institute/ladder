        "torchvision": "https://download.pytorch.org/whl/cu130",
    },
    hub_name = "pip-inference-robots-simpler",
    python_version = "3.10",
    requirements_lock = "//:ladder/components/inference/robots/simpler/requirements.txt.lock",
    target_platforms = ["linux_x86_64"],
)

use_repo(pip, "pip-inference-robots-simpler")

