# -----------------------------------------------------------------------------
# Set up pip-inference-robots-robolab environment
# -----------------------------------------------------------------------------

# Unlike the other robot envs, robolab derives from inference-core (not inference-server):
# its pyproject depends on api-core, deliberately NOT api-server, which pins pyrealsense2/pyudev
# (no cp312 wheels for robolab's Isaac Sim 6 / py3.12 env). Deriving from inference-server makes
# api/server:server's pip_deps select() emit a robolab branch referencing
# @pip-inference-robots-robolab//{pyrealsense2,pyudev}, absent from robolab's lock, which breaks
# `bazel query` (e.g. make test-deps) even though the build selects only the active branch.
pip_env.env(
    name = "inference-robots-robolab",
    deps = ["inference-core"],
    paths = ["ladder/components/inference/robots/robolab"],
    pyproject = "//ladder/components/inference/robots/robolab:pyproject.toml",
    # isaacsim 6 ships cp312-only wheels; pip_defs makes every target in this env
    # target_compatible_with py3.12 (must match this env's pip.parse python_version below).
    python_version = "3.12",
)

pip.parse(
    # isaacsim's transitive subpackages live only on pypi.nvidia.com.
    extra_pip_args = ["--extra-index-url=https://pypi.nvidia.com/"],
    hub_name = "pip-inference-robots-robolab",
    python_version = "3.12",
    requirements_lock = "//:ladder/components/inference/robots/robolab/requirements.txt.lock",
    timeout = 3600,  # multi-GB isaacsim wheels exceed the default 600s on a cold cache
)

use_repo(pip, "pip-inference-robots-robolab")

