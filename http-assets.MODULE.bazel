# Hermetic sim/robot-benchmark archives: asset tarballs, benchmark code drops, vendored sources
# and weights. Split out of MODULE.bazel (include()d from there) to keep the module file readable
# as these pins grew; same pattern as the pip-*.MODULE.bazel segments.
#
# Everything we may redistribute is on the repository's assets-v1 release, so the build downloads it
# from one place. CUDA, the WidowX model and GPT-Policy are not licensed for redistribution and come
# from upstream; each says so where it is pinned.

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# ManiSkill3 bridge digital twins, bundled hermetically (see robots/simpler/BUILD).
http_archive(
    name = "simpler_maniskill3_assets_archive",
    build_file_content = """
filegroup(
    name = "maniskill3_files",
    srcs = glob(["data/**/*"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-36Rd6KJnDMbwW7nbKM3xa266vCT0H+EKPL4P8b3lOp8=",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/simpler_assets.tar.gz",
)

