# Hermetic sim/robot-benchmark archives: asset tarballs, benchmark code drops, and vendored
# sources. Split out of MODULE.bazel (include()d from there) to keep the module file readable
# as these pins grew; same pattern as the pip-*.MODULE.bazel segments.

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# For the multi-GB asset archives: one connection per URL caps at ~14 MB/s, chunked parallel ranges
# reach ~105 MB/s. See build_support/repo/parallel_http_archive.bzl.
parallel_http_archive = use_repo_rule("//build_support/repo:parallel_http_archive.bzl", "parallel_http_archive")

# ManiSkill3 bridge digital twins + widowx robot assets, bundled hermetically (see
# robots/simpler/BUILD).
http_archive(
    name = "simpler_maniskill3_assets_archive",
    build_file_content = """
filegroup(
    name = "maniskill3_files",
    srcs = glob(["data/**/*"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-06OUwcbZJES+djY8uDkshu1sDVNOOtBnQwTI5gUwyHc=",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/simpler_maniskill3_assets.tar.gz",
)

# SAPIEN's precompiled PhysX GPU library. SAPIEN downloads this to ~/.sapien/physx/<version> on the
# first physx.enable_gpu(); vendoring it here (bazel fetches at build time, when network is allowed)
# lets env_builder seed that cache so hermetic GPU tests/evals need no runtime download. Pinned to the
# sapien version in requirements (105.1-physx-5.3.1.patch0); bump both together on a sapien upgrade.
http_archive(
    name = "sapien_physx_precompiled",
    build_file_content = """
filegroup(
    name = "physx_so",
    srcs = ["libPhysXGpu_64.so"],
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-FnoBqtc4Gv75Y7iRaZaMKJ57ZTiAp6gjwRbYfuXAD8Y=",
    url = "https://github.com/sapien-sim/physx-precompiled/releases/download/105.1-physx-5.3.1.patch0/linux-so.zip",
)

