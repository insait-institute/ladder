# curobo, pristine upstream (our tree is byte-identical to it): vendored as source so the
# planner's collision stack is reviewable and pinned next to the patch that uses it.
http_archive(
    name = "curobo_src",
    build_file_content = """
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "curobo",
    srcs = glob(["src/curobo/**/*.py"]),
    # The package's own content tree (robot/world/task configs) and the curobolib cpp/kernel
    # sources the fused ops JIT-compile from at server startup, which resolve beside the package.
    data = glob(
        [
            "src/curobo/content/**/*",
            "src/curobo/curobolib/cpp/**/*",
            "src/curobo/curobolib/lib/**/*",
        ],
        exclude = ["**/__pycache__/**"],
    ),
    imports = ["src"],
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-BKx/U9OtoKqP+OPwIY3+qmZu9CIHlEbCnwxZMXnonNY=",
    strip_prefix = "curobo-b5fad1df2a3ac4d3e33e369918b7d62d0e59ebd1",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/curobo_src.tar.gz",
)

# M2T2 grasp proposer, pristine upstream. pointnet2_ops builds against nvcc at server
# startup off the toolchain in the models/tiptop environment, like curobo above.
http_archive(
    name = "m2t2_src",
    build_file_content = """
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "m2t2",
    srcs = glob(
        [
            "m2t2/**/*.py",
            "pointnet2_ops/**/*.py",
        ],
        exclude = ["**/test*/**"],
    ),
    # pointnet2's cpp/cu extension JIT-compiles at server startup against the nvcc tree in
    # the models/tiptop environment; those sources ride as data.
    data = glob(
        [
            "pointnet2_ops/pointnet2_ops/_ext-src/**/*",
        ],
        exclude = ["**/test*/**"],
    ),
    imports = ["."],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "m2t2_data",
    srcs = glob(
        [
            "m2t2/**/*.yaml",
            "*.yaml",
        ],
        exclude = ["**/test*/**"],
    ),
    visibility = ["//visibility:public"],
)
""",
    patch_args = ["-p1"],
    patches = [
        "//build_support/python/patches:m2t2_pointnet2_ext_src.patch",
    ],
    integrity = "sha256-AAkR6j+ginAXuskNOFqH7wNpCAqMTnBG+VEo+9PxBd8=",
    strip_prefix = "M2T2-96201acdb77baa1bc9d01bdf4d6f870d79b4b696",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/m2t2_src.tar.gz",
)

