# openpi, vendored as source rather than installed as a package: its own dependency set pulls the
# LeRobot training stack and a CUDA torch that conflicts with our jax, and we only need inference.
# openpi_client is the wire protocol and image tools; openpi_src is the full model library.
http_archive(
    name = "openpi_client_repo",
    build_file_content = """
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "openpi_client",
    srcs = glob(
        ["packages/openpi-client/src/openpi_client/**/*.py"],
        exclude = ["**/*_test.py"],
    ),
    imports = ["packages/openpi-client/src"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "openpi_src",
    srcs = glob(
        ["src/openpi/**/*.py"],
        exclude = ["**/*_test.py"],
    ),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":openpi_client"],
)
""",
    sha256 = "2e36927c2c77ffaf111a16e5533d6d4ac26ea00fb47c1650f95a96e5d9f078de",
    strip_prefix = "openpi-aa6420561529593114160d05e5ad155792b272f3",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/openpi_src.tar.gz",
)

