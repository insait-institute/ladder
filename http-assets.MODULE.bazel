# The M2T2 grasp weights and the SAM-2 checkpoint download at server startup into the
# session's cache dir, like openpi checkpoints and SAM-3 weights: no build-time fetch.

# CUDA 12.9's compiler, runtime and C++ core libraries, from NVIDIA's redistributable archives
# (the CUDA license does not let us host them). TiPToP merges them into the CUDA_HOME that curobo
# and M2T2 compile their kernels against at server startup; see models/tiptop/BUILD. lib64 is the
# path torch's extension builder links against.
CUDA_ARCHIVE_BUILD = """
filegroup(
    name = "files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "WORKSPACE", "REPO.bazel"]),
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "cuda_nvcc_archive",
    build_file_content = CUDA_ARCHIVE_BUILD,
    patch_cmds = ["ln -s lib lib64"],
    sha256 = "b3a0e115840e04c0cfa559263cbbe8b78a2455788e12605732aff68abc50dd34",
    strip_prefix = "cuda_nvcc-linux-x86_64-12.9.41-archive",
    url = "https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvcc/linux-x86_64/cuda_nvcc-linux-x86_64-12.9.41-archive.tar.xz",
)

http_archive(
    name = "cuda_cudart_archive",
    build_file_content = CUDA_ARCHIVE_BUILD,
    patch_cmds = ["ln -s lib lib64"],
    sha256 = "db950a2443a34daa10069c8df1bccec868af3144cb898cd1d903a9ea04cccfa4",
    strip_prefix = "cuda_cudart-linux-x86_64-12.9.37-archive",
    url = "https://developer.download.nvidia.com/compute/cuda/redist/cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-12.9.37-archive.tar.xz",
)

http_archive(
