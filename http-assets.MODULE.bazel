# RoboLab benchmark code (no LFS assets — those ship via @robolab_assets_archive). The patch makes
# robolab resolve assets from ROBOLAB_ASSET_DIR (the staged tree) instead of its repo-root assets/.
http_archive(
    name = "robolab_repo",
    build_file_content = """
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "robolab_src",
    srcs = glob([
        "robolab/**/*.py",
        "policies/**/*.py",
        "dashboard/**/*.py",
    ]),
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
    patch_args = ["-p1"],
    patches = [
        "//build_support/python/patches:robolab_constants_asset_dir.patch",
    ],
    sha256 = "ffcd150871ead600dd84b9302459a66b9a1e59f4ed2cc7a07a44ac6c0b27b4a5",
    strip_prefix = "RoboLab-27b6212df31799f72883bd79c8629607d89782de",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/robolab_src.tar.gz",
)

