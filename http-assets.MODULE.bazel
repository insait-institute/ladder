# The M2T2 grasp weights and the SAM-2 checkpoint download at server startup into the
# session's cache dir, like openpi checkpoints and SAM-3 weights: no build-time fetch.

# The one directory torch's extension compiler wants: NVIDIA's nvcc and cudart redist
# tarballs merged into bin/, include/, lib/ (with lib as lib64) and nvvm/. curobo compiles
# its fused ops at server startup against it, with the pip nvcc wheel carrying only ptxas.
http_archive(
    name = "cuda_home_archive",
    build_file_content = """
filegroup(
    name = "files",
    srcs = glob([
        "cuda_home/**/*",
    ]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-gZhLQ2T8pyy5eYLMJecQ1xpw0TKNfM7hhx/kIRb6ngY=",
    url = "https://github.com/insait-institute/ladder/releases/download/assets-v1/cuda_home.tar.gz",
)

